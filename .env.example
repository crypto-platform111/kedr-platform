# Safe local configuration examples. No real credentials or prices included.
KEDR_DATA_DIR=data
# Hosted Vercel uses shared PostgreSQL; blank preserves local SQLite.
KEDR_DATABASE_URL=
# Job mode defaults to durable with PostgreSQL and local with SQLite.
# KEDR_JOB_MODE=durable
# Server-only random >=32-character secret for the protected outbox cron.
CRON_SECRET=
# Optional external read-only archive checkout. Leave blank for demo-only use.
KEDR_LEGACY_ROOT=
KEDR_SECURE_COOKIES=0
# KEDR_ALLOWED_HOSTS=localhost,127.0.0.1
# Optional exact additional origins, for a custom domain or vercel dev on port 3000.
# KEDR_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# Vercel cloud needs KEDR_SECURE_COOKIES=1; do not copy local 0 to HTTPS hosting.
# Do not set generated Vercel service-binding URL variables manually.

# Optional actual OpenAI Responses adapter. Disabled by default.
# External requests additionally require explicit per-message consent.
KEDR_AI_PROVIDER=disabled
KEDR_AI_API_KEY=
KEDR_AI_MODEL=
KEDR_AI_TIMEOUT_SECONDS=20
KEDR_AI_MAX_OUTPUT_TOKENS=2500
KEDR_AI_DAILY_TOKEN_LIMIT=200000
KEDR_AI_DAILY_REQUEST_LIMIT=20
KEDR_AI_DAILY_USD_LIMIT=1
# Enter current conservative ceilings for the chosen model before enabling.
# Zero leaves the adapter unconfigured; these are NOT example market prices.
KEDR_AI_INPUT_USD_PER_MILLION=0
KEDR_AI_OUTPUT_USD_PER_MILLION=0

# News/sentiment adapters remain disconnected; fixtures are labelled.
KEDR_NEWS_PROVIDER=demo
KEDR_NEWS_API_KEY=
KEDR_SENTIMENT_PROVIDER=disabled
# Native bounded local ML does not need a remote training service.
KEDR_TRAINING_PROVIDER=disabled
KEDR_TRAINING_SERVICE_URL=
# Live/private exchange credentials and trading are unsupported.
